Option Strict On
Option Explicit On

Imports System.Text
Imports System.Drawing
Imports System.Windows.Forms
Imports System.Collections.Generic

Public Class Form1
    Inherits Form

    ' UI root controls
    Private mnuMain As MenuStrip
    Private pnlContent As Panel
    ' Modern navigation sidebar
    Private navPanel As Panel
    Private navFlow As FlowLayoutPanel

    ' Theme colors
    Private ReadOnly Theme_Background As Color = Color.FromArgb(10, 12, 25) ' very dark navy
    Private ReadOnly Theme_Card As Color = Color.FromArgb(20, 28, 48) ' dark blue-gray
    Private ReadOnly Theme_Primary As Color = Color.FromArgb(6, 34, 64) ' deep dark blue
    Private ReadOnly Theme_Accent As Color = Color.FromArgb(0, 170, 255) ' bright electric blue
    Private ReadOnly Theme_Text As Color = Color.FromArgb(235, 240, 245)
    Private ReadOnly Theme_SubText As Color = Color.FromArgb(150, 170, 190)
    Private ReadOnly Theme_Border As Color = Color.FromArgb(14, 45, 80)

    ' Animation Level 1 controls (created when needed)
    Private animPanel As Panel
    Private animTimer As Timer
    Private animBoatX As Integer
    Private animBoatTargetX As Integer
    Private animBoatMoving As Boolean
    Private animMoveCounter As Integer
    Private animState As CannibalsState

    ' Constructor
    Public Sub New()
        MyBase.New()
        Me.Text = "PF101 - Object Oriented Programming Created by: Lastname, Firstname M.I."
        Me.ClientSize = New Size(1000, 700)
        Me.StartPosition = FormStartPosition.CenterScreen

        ' Build UI (modern dark-themed layout)
        BuildMenu()
        BuildModernUI()
    End Sub

    ' Build the MenuStrip programmatically
    Private Sub BuildMenu()
        ' Keep a hidden MenuStrip for compatibility (not visible)
        mnuMain = New MenuStrip() With {.Dock = DockStyle.Top, .Visible = False}
        Me.MainMenuStrip = mnuMain
        Me.Controls.Add(mnuMain)
    End Sub

    ' Build a modern sidebar navigation and content area
    Private Sub BuildModernUI()
        ' Base form styling
        Me.BackColor = Theme_Background
        Me.Font = New Font("Segoe UI", 9.0F)

        ' Navigation panel
        navPanel = New Panel() With {
            .Dock = DockStyle.Left,
            .Width = 260,
            .BackColor = Color.FromArgb(12, 16, 30),
            .Padding = New Padding(12)
        }
        Me.Controls.Add(navPanel)

        Dim header As New Label() With {
            .Text = "PF101",
            .Font = New Font("Segoe UI", 14.0F, FontStyle.Bold),
            .ForeColor = Theme_Text,
            .AutoSize = True,
            .Location = New Point(14, 12)
        }
        navPanel.Controls.Add(header)

        Dim subHeader As New Label() With {
            .Text = "Object Oriented Programming",
            .Font = New Font("Segoe UI", 9.0F),
            .ForeColor = Theme_SubText,
            .AutoSize = True,
            .Location = New Point(14, 38)
        }
        navPanel.Controls.Add(subHeader)

        ' Navigation flow panel
        navFlow = New FlowLayoutPanel() With {
            .FlowDirection = FlowDirection.TopDown,
            .Dock = DockStyle.Fill,
            .AutoScroll = True,
            .WrapContents = False,
            .Location = New Point(0, 70),
            .Padding = New Padding(8)
        }
        navPanel.Controls.Add(navFlow)

        ' Helper to add nav button
        Dim addNav As Action(Of String, Action) = Sub(text, act)
                                                      Dim b As New Button() With {
                                                           .Text = text,
                                                           .AutoSize = False,
                                                           .Size = New Size(navPanel.Width - 40, 40),
                                                           .FlatStyle = FlatStyle.Flat,
                                                           .BackColor = Color.Transparent,
                                                           .ForeColor = Theme_SubText,
                                                           .TextAlign = ContentAlignment.MiddleLeft,
                                                           .Padding = New Padding(12, 0, 0, 0)
                                                       }
                                                      b.FlatAppearance.BorderSize = 0
                                                      AddHandler b.Click, Sub(s, e)
                                                                              ' clear selection look
                                                                              For Each c As Control In navFlow.Controls
                                                                                  If TypeOf c Is Button Then
                                                                                      c.BackColor = Color.Transparent
                                                                                      c.ForeColor = Theme_SubText
                                                                                  End If
                                                                              Next
                                                                              b.BackColor = Theme_Primary
                                                                              b.ForeColor = Theme_Text
                                                                              act.Invoke()
                                                                          End Sub
                                                      AddHandler b.MouseEnter, Sub(s, e) If b.BackColor = Color.Transparent Then b.ForeColor = Theme_Text
                                                      AddHandler b.MouseLeave, Sub(s, e) If b.BackColor = Color.Transparent Then b.ForeColor = Theme_SubText
                                                      navFlow.Controls.Add(b)
                                                  End Sub

        ' Build navigation items (Lessons as an expandable group)
        Dim btnLessons As New Button() With {.Text = "Lessons", .AutoSize = False, .Size = New Size(navPanel.Width - 40, 40), .FlatStyle = FlatStyle.Flat, .BackColor = Theme_Primary, .ForeColor = Theme_Text, .Padding = New Padding(12, 0, 0, 0)}
        btnLessons.FlatAppearance.BorderSize = 0
        navFlow.Controls.Add(btnLessons)

        Dim lessonsPanel As New FlowLayoutPanel() With {.FlowDirection = FlowDirection.TopDown, .AutoSize = True, .WrapContents = False, .Padding = New Padding(8, 4, 8, 8)}
        navFlow.Controls.Add(lessonsPanel)

        ' Lesson items
        addNav("Orientations", AddressOf ShowOrientations)

        ' Introduction group header and subitems
        Dim introHeader As New Label() With {.Text = "Introduction in OOP", .ForeColor = Theme_Text, .AutoSize = True, .Font = New Font("Segoe UI", 9.0F, FontStyle.Bold), .Padding = New Padding(6)}
        lessonsPanel.Controls.Add(introHeader)
        Dim introSub As New FlowLayoutPanel() With {.FlowDirection = FlowDirection.TopDown, .AutoSize = True, .WrapContents = False, .Padding = New Padding(8, 0, 0, 8)}
        lessonsPanel.Controls.Add(introSub)
        Dim addIntro As Action(Of String, Action) = Sub(txt, a)
                                                        Dim btn As New Button() With {
                                                           .Text = txt,
                                                           .AutoSize = False,
                                                           .Size = New Size(navPanel.Width - 80, 32),
                                                           .FlatStyle = FlatStyle.Flat,
                                                           .BackColor = Color.Transparent,
                                                           .ForeColor = Theme_SubText,
                                                           .Padding = New Padding(8, 0, 0, 0)
                                                       }
                                                        btn.FlatAppearance.BorderSize = 0
                                                        AddHandler btn.Click, Sub(s, e)
                                                                                  a.Invoke()
                                                                                  btn.ForeColor = Theme_Text
                                                                              End Sub
                                                        introSub.Controls.Add(btn)
                                                    End Sub
        addIntro("Classes and Objects", Sub() ShowIntro_OOP("Classes and Objects"))
        addIntro("Encapsulation", Sub() ShowIntro_OOP("Encapsulation"))
        addIntro("Inheritance", Sub() ShowIntro_OOP("Inheritance"))
        addIntro("Polymorphism", Sub() ShowIntro_OOP("Polymorphism"))

        addNav("Getting Started with Microsoft VB.NET", AddressOf ShowGettingStarted)
        addNav("Planning Applications and Designing Interfaces", AddressOf ShowPlanning)
        addNav("Data Handling", AddressOf ShowDataHandling)
        addNav("Coding with Variable Names, Constants and Calculations", AddressOf ShowCodingSelectionRepetition)
        addNav("Arrays", AddressOf ShowArrays)
        addNav("Working with Controls and Properties", AddressOf ShowControlsProperties)
        addNav("Midterm Examinations", AddressOf ShowMidterm)

        ' Other top-levels
        Dim btnAnimation As New Button() With {.Text = "Animation", .AutoSize = False, .Size = New Size(navPanel.Width - 40, 40), .FlatStyle = FlatStyle.Flat, .BackColor = Color.Transparent, .ForeColor = Theme_SubText, .Padding = New Padding(12, 0, 0, 0)}
        btnAnimation.FlatAppearance.BorderSize = 0
        navFlow.Controls.Add(btnAnimation)
        Dim animSub As New FlowLayoutPanel() With {.FlowDirection = FlowDirection.TopDown, .AutoSize = True, .WrapContents = False, .Padding = New Padding(8, 4, 8, 8)}
        navFlow.Controls.Add(animSub)
        Dim btnL1 As New Button() With {.Text = "Level 1", .Size = New Size(navPanel.Width - 80, 32), .FlatStyle = FlatStyle.Flat, .BackColor = Color.Transparent, .ForeColor = Theme_SubText, .Padding = New Padding(8, 0, 0, 0)}
        btnL1.FlatAppearance.BorderSize = 0
        AddHandler btnL1.Click, Sub(s, e) ShowAnimation_Level1()
        animSub.Controls.Add(btnL1)
        Dim btnL2 As New Button() With {.Text = "Level 2", .Size = New Size(navPanel.Width - 80, 32), .FlatStyle = FlatStyle.Flat, .BackColor = Color.Transparent, .ForeColor = Theme_SubText, .Padding = New Padding(8, 0, 0, 0)}
        btnL2.FlatAppearance.BorderSize = 0
        AddHandler btnL2.Click, Sub(s, e) ShowAnimation_Level2()
        animSub.Controls.Add(btnL2)

        ' Help / Exit / Section
        addNav("Help", Sub() MessageBox.Show("Help is not implemented.", "Help", MessageBoxButtons.OK, MessageBoxIcon.Information))
        addNav("Section", Sub()
                          End Sub)
        Dim btnExit As New Button() With {.Text = "Exit", .AutoSize = False, .Size = New Size(navPanel.Width - 40, 40), .FlatStyle = FlatStyle.Flat, .BackColor = Color.Transparent, .ForeColor = Theme_SubText, .Padding = New Padding(12, 0, 0, 0)}
        btnExit.FlatAppearance.BorderSize = 0
        AddHandler btnExit.Click, Sub(s, e) Me.Close()
        navFlow.Controls.Add(btnExit)

        ' Content panel
        pnlContent = New Panel() With {.Dock = DockStyle.Fill, .Padding = New Padding(16), .BackColor = Theme_Background, .AutoScroll = True}
        Me.Controls.Add(pnlContent)

        ' Show default page
        ShowOrientations()
    End Sub

    ' Generic factory: creates the three-area layout inside a panel and returns it.
    ' Parameters:
    '  - title: lesson/topic title
    '  - explanation: explanatory text
    '  - codeText: VB code sample displayed in monospace (original slide text possibly corrected)
    '  - exampleRunner: Action that runs when Run Example is pressed; receives the output control (Control)
    '  - outputControlType: "RichTextBox" or "ListBox" (default RichTextBox)
    Private Function CreateLessonPanel(title As String,
                                       explanation As String,
                                       codeText As String,
                                       exampleRunner As Action(Of Control),
                                       Optional outputControlType As String = "RichTextBox",
                                       Optional extraControls As Action(Of Panel) = Nothing) As Panel
        ' Root panel
        Dim panel As New Panel() With {
            .Dock = DockStyle.Fill,
            .BackColor = Theme_Background,
            .AutoScroll = True
        }

        ' Header
        Dim lblTitle As New Label() With {
            .Text = title,
            .Font = New Font("Segoe UI", 14.0F, FontStyle.Bold),
            .ForeColor = Theme_Text,
            .AutoSize = True,
            .Location = New Point(8, 8)
        }
        panel.Controls.Add(lblTitle)

        ' subtitle (if title contains " - ")
        Dim subtitle As String = "Lesson"
        If title.Contains(" - ") Then subtitle = title.Substring(0, title.IndexOf(" - ")).Trim()
        Dim lblSub As New Label() With {
            .Text = subtitle,
            .Font = New Font("Segoe UI", 9.0F),
            .ForeColor = Theme_SubText,
            .AutoSize = True,
            .Location = New Point(8, 36)
        }
        panel.Controls.Add(lblSub)

        ' Main content area uses a TableLayout: left column for explanation+code, right column for output and extras
        Dim tbl As New TableLayoutPanel() With {
            .Location = New Point(8, 64),
            .Size = New Size(panel.Width - 24, panel.Height - 80),
            .Dock = DockStyle.Top,
            .AutoSize = False,
            .ColumnCount = 2,
            .RowCount = 1
        }
        tbl.ColumnStyles.Add(New ColumnStyle(SizeType.Percent, 68.0F))
        tbl.ColumnStyles.Add(New ColumnStyle(SizeType.Percent, 32.0F))
        tbl.RowStyles.Add(New RowStyle(SizeType.AutoSize))
        panel.Controls.Add(tbl)

        ' Left column panel
        Dim leftCol As New Panel() With {.Dock = DockStyle.Fill, .Padding = New Padding(8), .BackColor = Color.Transparent}
        tbl.Controls.Add(leftCol, 0, 0)

        ' Explanation card
        Dim cardExplain As New Panel() With {.BackColor = Theme_Card, .Dock = DockStyle.Top, .Height = 140, .Padding = New Padding(8)}
        leftCol.Controls.Add(cardExplain)
        Dim rtbExplain As New RichTextBox() With {.ReadOnly = True, .BorderStyle = BorderStyle.None, .Dock = DockStyle.Fill, .Font = New Font("Segoe UI", 10.0F), .Text = explanation, .BackColor = Theme_Card, .ForeColor = Theme_Text}
        cardExplain.Controls.Add(rtbExplain)

        ' Code card below
        Dim cardCode As New Panel() With {.BackColor = Color.FromArgb(10, 14, 28), .Dock = DockStyle.Top, .Height = 260, .Padding = New Padding(8), .Top = cardExplain.Bottom + 8}
        leftCol.Controls.Add(cardCode)
        Dim lblCodeHeader As New Label() With {.Text = "Code (from slides)", .Font = New Font("Segoe UI", 9.0F, FontStyle.Bold), .ForeColor = Theme_SubText, .Dock = DockStyle.Top, .Height = 20}
        cardCode.Controls.Add(lblCodeHeader)
        Dim rtbCode As New RichTextBox() With {.ReadOnly = True, .Font = New Font("Consolas", 10.0F), .Text = codeText, .Dock = DockStyle.Fill, .BackColor = Color.FromArgb(6, 10, 20), .ForeColor = Theme_Text, .BorderStyle = BorderStyle.None}
        cardCode.Controls.Add(rtbCode)

        ' Right column panel for output and extras
        Dim rightCol As New Panel() With {.Name = "pnlRightColumn", .Dock = DockStyle.Fill, .Padding = New Padding(8), .BackColor = Color.Transparent}
        tbl.Controls.Add(rightCol, 1, 0)

        ' Output card
        Dim cardOut As New Panel() With {.BackColor = Color.FromArgb(6, 8, 16), .Dock = DockStyle.Top, .Height = 220, .Padding = New Padding(8)}
        rightCol.Controls.Add(cardOut)
        Dim lblOutHeader As New Label() With {.Text = "Output", .Font = New Font("Segoe UI", 9.0F, FontStyle.Bold), .ForeColor = Theme_SubText, .Dock = DockStyle.Top, .Height = 20}
        cardOut.Controls.Add(lblOutHeader)

        Dim outputControl As Control
        If outputControlType = "ListBox" Then
            Dim lst As New ListBox() With {.Dock = DockStyle.Fill, .Font = New Font("Consolas", 10.0F), .BackColor = Color.FromArgb(6, 8, 16), .ForeColor = Theme_Text}
            outputControl = lst
        Else
            Dim rtbOut As New RichTextBox() With {.Dock = DockStyle.Fill, .Font = New Font("Consolas", 10.0F), .ReadOnly = True, .BackColor = Color.FromArgb(6, 8, 16), .ForeColor = Theme_Text, .BorderStyle = BorderStyle.None}
            outputControl = rtbOut
        End If
        cardOut.Controls.Add(outputControl)

        ' Run button under output
        Dim btnRun As New Button() With {.Text = "Run ▶", .Height = 36, .Dock = DockStyle.Top, .FlatStyle = FlatStyle.Flat, .BackColor = Theme_Accent, .ForeColor = Color.Black, .Font = New Font("Segoe UI", 9.0F, FontStyle.Bold)}
        btnRun.FlatAppearance.BorderSize = 0
        AddHandler btnRun.Click, Sub(s, e)
                                     Try
                                         exampleRunner.Invoke(outputControl)
                                     Catch ex As Exception
                                         If TypeOf outputControl Is RichTextBox Then
                                             DirectCast(outputControl, RichTextBox).AppendText("Error running example: " & ex.Message & vbCrLf)
                                         ElseIf TypeOf outputControl Is ListBox Then
                                             DirectCast(outputControl, ListBox).Items.Add("Error: " & ex.Message)
                                         End If
                                     End Try
                                 End Sub
        rightCol.Controls.Add(btnRun)

        ' Extra area for lesson-specific controls
        Dim extraArea As New Panel() With {.Dock = DockStyle.Fill, .AutoScroll = True, .BackColor = Color.Transparent}
        rightCol.Controls.Add(extraArea)

        ' Allow lesson-specific extra controls to add into the right column's extraArea
        If extraControls IsNot Nothing Then
            ' Pass a wrapper panel that exposes the extraArea for placement
            Dim wrapper As New Panel() With {.Dock = DockStyle.Fill}
            wrapper.Controls.Add(extraArea)
            extraControls.Invoke(wrapper)
        End If

        Return panel
    End Function

    ' ----- Lesson content builders -----
    Private Sub ShowOrientations()
        pnlContent.Controls.Clear()
        Dim explanation As String = "[ORIENTATION CONTENT - TO BE PROVIDED]"
        Dim codeText As String = "' No code provided for orientations" & vbCrLf
        Dim lessonPanel = CreateLessonPanel("Orientations", explanation, codeText, Sub(output)
                                                                                       If TypeOf output Is RichTextBox Then
                                                                                           DirectCast(output, RichTextBox).Text = "No runnable example for Orientations."
                                                                                       End If
                                                                                   End Sub)
        pnlContent.Controls.Add(lessonPanel)
    End Sub

    Private Sub ShowIntro_OOP(topic As String)
        pnlContent.Controls.Clear()
        If topic = "Classes and Objects" Then
            Dim explanation As String = "A class is a blueprint. An object is an instance created by instantiation. Example: Person class with Name and Age." & vbCrLf &
                                        "This sample creates a Person and shows properties."
            Dim codeText As String = "' Sample: Person class usage" & vbCrLf &
                                     "Dim p As New Person()" & vbCrLf &
                                     "p.Name = ""Alice""" & vbCrLf &
                                     "p.Age = 30" & vbCrLf &
                                     "Console.WriteLine($""Name: {p.Name}, Age: {p.Age}"")" & vbCrLf &
                                     "' Note: Console.WriteLine is shown in code; Run will append to the output box."
            Dim runner As Action(Of Control) = Sub(output)
                                                   If TypeOf output Is RichTextBox Then
                                                       Dim rtb = DirectCast(output, RichTextBox)
                                                       Dim p As New Person() With {.Name = "Alice", .Age = 30}
                                                       rtb.AppendText($"Name: {p.Name}, Age: {p.Age}" & vbCrLf)
                                                   End If
                                               End Sub
            pnlContent.Controls.Add(CreateLessonPanel("Introduction - Classes and Objects", explanation, codeText, runner))
        ElseIf topic = "Encapsulation" Then
            Dim explanation As String = "Encapsulation bundles data and methods, hides internal state, and exposes well-defined members." & vbCrLf &
                                        "Below is an interactive demo: use Deposit, Withdraw, Balance Inquiry. All balance access goes through BankAccount methods."
            Dim codeText As String = "' BankAccount class (excerpt)" & vbCrLf &
                                     "Public Class BankAccount" & vbCrLf &
                                     "    Private balance As Decimal" & vbCrLf &
                                     "    Public Sub Deposit(amount As Decimal)" & vbCrLf &
                                     "        ' validation inside" & vbCrLf &
                                     "    End Sub" & vbCrLf &
                                     "    Public Function GetBalance() As Decimal" & vbCrLf &
                                     "        Return balance" & vbCrLf &
                                     "    End Function" & vbCrLf &
                                     "End Class" & vbCrLf &
                                     "' Note: corrected from slide where some methods were incomplete."
            ' Extra controls: amount TextBox, Deposit, Withdraw, Balance Inquiry, result Label
            Dim extra As Action(Of Panel) = Sub(parent)
                                                ' parent is a wrapper that contains the extraArea as first child
                                                Dim extraArea As Panel = Nothing
                                                If parent.Controls.Count > 0 Then extraArea = TryCast(parent.Controls(0), Panel)
                                                If extraArea Is Nothing Then extraArea = parent

                                                Dim flow As New FlowLayoutPanel() With {.FlowDirection = FlowDirection.TopDown, .Dock = DockStyle.Top, .AutoSize = True, .Padding = New Padding(6)}
                                                extraArea.Controls.Add(flow)

                                                Dim lblAmt As New Label() With {.Text = "Amount:", .AutoSize = True, .ForeColor = Theme_Text}
                                                Dim txtAmt As New TextBox() With {.Name = "txtEncapAmount", .Width = 160}
                                                Dim pnlButtons As New FlowLayoutPanel() With {.FlowDirection = FlowDirection.LeftToRight, .AutoSize = True}
                                                Dim btnDeposit As New Button() With {.Text = "Deposit", .AutoSize = True, .FlatStyle = FlatStyle.Flat, .BackColor = Theme_Primary, .ForeColor = Theme_Text}
                                                btnDeposit.FlatAppearance.BorderSize = 0
                                                Dim btnWithdraw As New Button() With {.Text = "Withdraw", .AutoSize = True, .FlatStyle = FlatStyle.Flat, .BackColor = Theme_Primary, .ForeColor = Theme_Text}
                                                btnWithdraw.FlatAppearance.BorderSize = 0
                                                Dim btnBalance As New Button() With {.Text = "Balance Inquiry", .AutoSize = True, .FlatStyle = FlatStyle.Flat, .BackColor = Color.Transparent, .ForeColor = Theme_SubText}
                                                btnBalance.FlatAppearance.BorderSize = 0

                                                flow.Controls.Add(lblAmt)
                                                flow.Controls.Add(txtAmt)
                                                pnlButtons.Controls.AddRange(New Control() {btnDeposit, btnWithdraw, btnBalance})
                                                flow.Controls.Add(pnlButtons)

                                                ' Store account instance in Tag of the flow panel
                                                flow.Tag = New BankAccount()

                                                Dim lblResult As New Label() With {.Name = "lblEncapResult", .Text = "", .AutoSize = False, .Width = 220, .Height = 60, .ForeColor = Theme_Text}
                                                flow.Controls.Add(lblResult)

                                                AddHandler btnDeposit.Click, Sub(s, e)
                                                                                 Dim acc = DirectCast(flow.Tag, BankAccount)
                                                                                 Dim amt As Decimal
                                                                                 If Decimal.TryParse(txtAmt.Text.Trim(), amt) AndAlso amt > 0D Then
                                                                                     acc.Deposit(amt)
                                                                                     lblResult.Text = $"Deposited {amt:C2}. New balance: {acc.GetBalance():C2}"
                                                                                 Else
                                                                                     lblResult.Text = "Invalid deposit amount. Enter a positive number."
                                                                                 End If
                                                                             End Sub

                                                AddHandler btnWithdraw.Click, Sub(s, e)
                                                                                  Dim acc = DirectCast(flow.Tag, BankAccount)
                                                                                  Dim amt As Decimal
                                                                                  If Decimal.TryParse(txtAmt.Text.Trim(), amt) AndAlso amt > 0D Then
                                                                                      Dim ok = acc.Withdraw(amt)
                                                                                      If ok Then
                                                                                          lblResult.Text = $"Withdrew {amt:C2}. New balance: {acc.GetBalance():C2}"
                                                                                      Else
                                                                                          lblResult.Text = "Withdraw failed: insufficient funds or invalid amount."
                                                                                      End If
                                                                                  Else
                                                                                      lblResult.Text = "Invalid withdraw amount. Enter a positive number."
                                                                                  End If
                                                                              End Sub

                                                AddHandler btnBalance.Click, Sub(s, e)
                                                                                 Dim acc = DirectCast(flow.Tag, BankAccount)
                                                                                 lblResult.Text = $"Balance: {acc.GetBalance():C2}"
                                                                             End Sub
                                            End Sub
            Dim runner As Action(Of Control) = Sub(output)
                                                   If TypeOf output Is RichTextBox Then
                                                       DirectCast(output, RichTextBox).AppendText("Use the Deposit / Withdraw / Balance Inquiry controls on the right." & vbCrLf)
                                                   End If
                                               End Sub
            pnlContent.Controls.Add(CreateLessonPanel("Introduction - Encapsulation", explanation, codeText, runner, "RichTextBox", extra))
        ElseIf topic = "Inheritance" Then
            Dim explanation As String = "Inheritance lets a class derive from another and reuse or override behavior. Example: Animal (base) and Dog (derived)."
            Dim codeText As String = "' Animal and Dog sample" & vbCrLf &
                                     "Public Class Animal" & vbCrLf &
                                     "    Public Overridable Function Speak() As String" & vbCrLf &
                                     "        Return ""(animal sound)""" & vbCrLf &
                                     "    End Function" & vbCrLf &
                                     "End Class" & vbCrLf &
                                     "Public Class Dog" & vbCrLf &
                                     "    Inherits Animal" & vbCrLf &
                                     "    Public Overrides Function Speak() As String" & vbCrLf &
                                     "        Return ""Dog barks""" & vbCrLf &
                                     "    End Function" & vbCrLf &
                                     "End Class"
            Dim runner As Action(Of Control) = Sub(output)
                                                   If TypeOf output Is RichTextBox Then
                                                       Dim a As Animal = New Dog()
                                                       DirectCast(output, RichTextBox).AppendText(a.Speak() & vbCrLf)
                                                   End If
                                               End Sub
            pnlContent.Controls.Add(CreateLessonPanel("Introduction - Inheritance", explanation, codeText, runner))
        ElseIf topic = "Polymorphism" Then
            Dim explanation As String = "Polymorphism allows using a base reference to hold derived objects and call overridden members."
            Dim codeText As String = "' Polymorphism example" & vbCrLf &
                                      "Dim a As Animal = New Dog()" & vbCrLf &
                                      "Console.WriteLine(a.Speak()) ' prints Dog barks"
            Dim runner As Action(Of Control) = Sub(output)
                                                   If TypeOf output Is RichTextBox Then
                                                       Dim a As Animal = New Dog()
                                                       DirectCast(output, RichTextBox).AppendText(a.Speak() & vbCrLf)
                                                   End If
                                               End Sub
            pnlContent.Controls.Add(CreateLessonPanel("Introduction - Polymorphism", explanation, codeText, runner))
        End If
    End Sub

    Private Sub ShowGettingStarted()
        pnlContent.Controls.Clear()
        Dim explanation As String = "What programming is, languages, compilers, parts of a program, and the IDE. Console samples shown as code are simulated in the output box because this is WinForms."
        Dim codeText As String = "' Console demonstration (shown as Console.WriteLine in the code sample)" & vbCrLf &
                                 "Console.WriteLine(""Hello, World"")" & vbCrLf &
                                 "Console.WriteLine($""2 + 3 = {2 + 3}"")"
        Dim runner As Action(Of Control) = Sub(output)
                                               If TypeOf output Is RichTextBox Then
                                                   Dim r = DirectCast(output, RichTextBox)
                                                   r.AppendText("Hello, World" & vbCrLf)
                                                   r.AppendText("2 + 3 = 5" & vbCrLf)
                                               End If
                                           End Sub
        pnlContent.Controls.Add(CreateLessonPanel("Getting Started with Microsoft VB.NET", explanation, codeText, runner))
    End Sub

    Private Sub ShowPlanning()
        pnlContent.Controls.Clear()
        Dim explanation As String = "Controls have properties, methods and events. Methods example: MessageBox.Show. The Form_Load handler runs on startup (Handles MyBase.Load). Common controls: Form, TextBox, Label, Button, ListBox, ComboBox, RadioButton, CheckBox, PictureBox, ProgressBar, ScrollBar, DateTimePicker. Anchor vs Dock and TabIndex/TabStop control keyboard navigation."
        Dim codeText As String = "' Example Form Load handler" & vbCrLf &
                                 "Private Sub Form1_Load(sender As Object, e As EventArgs) Handles MyBase.Load" & vbCrLf &
                                 "    MessageBox.Show(""Form loaded"")" & vbCrLf &
                                 "End Sub"
        Dim runner As Action(Of Control) = Sub(output)
                                               If TypeOf output Is RichTextBox Then
                                                   DirectCast(output, RichTextBox).AppendText("MessageBox.Show sample not run here. See designer or Form Load events." & vbCrLf)
                                               End If
                                           End Sub
        pnlContent.Controls.Add(CreateLessonPanel("Planning Applications and Designing Interfaces", explanation, codeText, runner))
    End Sub

    Private Sub ShowDataHandling()
        pnlContent.Controls.Clear()
        Dim explanation As String = "Variables, data types, naming rules, Dim, Const, ToString formats, conversions, arithmetic operators, precedence, assignment operators. Live exponent example uses Math.Pow."
        Dim codeText As String = "' Exponent example" & vbCrLf &
                                 "Dim baseValue As Double = 2.0" & vbCrLf &
                                 "Dim power As Double = 3.0" & vbCrLf &
                                 "Console.WriteLine(Math.Pow(baseValue, power))"
        Dim runner As Action(Of Control) = Sub(output)
                                               If TypeOf output Is RichTextBox Then
                                                   Dim r = DirectCast(output, RichTextBox)
                                                   Dim baseValue As Double = 2.0
                                                   Dim power As Double = 3.0
                                                   r.AppendText($"{baseValue}^{power} = {Math.Pow(baseValue, power):N0}" & vbCrLf)
                                               End If
                                           End Sub
        pnlContent.Controls.Add(CreateLessonPanel("Data Handling", explanation, codeText, runner))
    End Sub

    Private Sub ShowCodingSelectionRepetition()
        pnlContent.Controls.Clear()
        Dim explanation As String = "Selection: If / ElseIf / Else, Select Case, logical operators (And, Or, AndAlso, OrElse), string handling (ToUpper, ToLower, IsNumeric, Trim), loops (Do While, For...Next)."
        Dim codeText As String = "' If example" & vbCrLf &
                                 "Dim score As Integer = 75" & vbCrLf &
                                 "If score >= 90 Then" & vbCrLf &
                                 "    Console.WriteLine(""A"")" & vbCrLf &
                                 "ElseIf score >= 80 Then" & vbCrLf &
                                 "    Console.WriteLine(""B"")" & vbCrLf &
                                 "ElseIf score >= 70 Then" & vbCrLf &
                                 "    Console.WriteLine(""C"")" & vbCrLf &
                                 "Else" & vbCrLf &
                                 "    Console.WriteLine(""Fail"")" & vbCrLf &
                                 "End If"
        Dim runner As Action(Of Control) = Sub(output)
                                               If TypeOf output Is RichTextBox Then
                                                   Dim score As Integer = 75
                                                   Dim grade As String
                                                   If score >= 90 Then
                                                       grade = "A"
                                                   ElseIf score >= 80 Then
                                                       grade = "B"
                                                   ElseIf score >= 70 Then
                                                       grade = "C"
                                                   Else
                                                       grade = "Fail"
                                                   End If
                                                   DirectCast(output, RichTextBox).AppendText($"Score {score} → Grade {grade}" & vbCrLf)
                                               End If
                                           End Sub
        pnlContent.Controls.Add(CreateLessonPanel("Coding with Variable Names, Constants and Calculations (Selection & Repetition)", explanation, codeText, runner))
    End Sub

    Private Sub ShowArrays()
        pnlContent.Controls.Clear()
        Dim explanation As String = "Arrays: Dim name(upper) As Type, implicit sizing with { }, one- and multi-dimensional arrays, passing arrays to functions, returning arrays. Lab example: output months of the year."
        Dim codeText As String = "' Months array example" & vbCrLf &
                                 "Dim months() As String = {""January"", ""February"", ""March"", ... }" & vbCrLf &
                                 "For i As Integer = 0 To months.Length - 1" & vbCrLf &
                                 "    Console.WriteLine(months(i))" & vbCrLf &
                                 "Next"
        ' Example outputs to ListBox
        Dim runner As Action(Of Control) = Sub(output)
                                               If TypeOf output Is ListBox Then
                                                   Dim lst = DirectCast(output, ListBox)
                                                   lst.Items.Clear()
                                                   Dim months() As String = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
                                                   For i As Integer = 0 To months.Length - 1
                                                       lst.Items.Add(months(i))
                                                   Next
                                               ElseIf TypeOf output Is RichTextBox Then
                                                   Dim r As RichTextBox = DirectCast(output, RichTextBox)
                                                   r.Clear()
                                                   Dim months() As String = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
                                                   For i As Integer = 0 To months.Length - 1
                                                       r.AppendText(months(i) & vbCrLf)
                                                   Next
                                               End If
                                           End Sub
        pnlContent.Controls.Add(CreateLessonPanel("Arrays", explanation, codeText, runner, "ListBox"))
    End Sub

    Private Sub ShowControlsProperties()
        pnlContent.Controls.Clear()
        Dim explanation As String = "Dialog boxes: ColorDialog, FontDialog, OpenFileDialog, SaveFileDialog, PrintDialog. Use ShowDialog and handle the returned DialogResult. Live demos below change control properties at runtime. [TREEVIEW / LISTVIEW CONTENT - NOT IN SLIDES]"
        Dim codeText As String = "' Example: ColorDialog usage" & vbCrLf &
                                 "If colorDlg.ShowDialog() = DialogResult.OK Then" & vbCrLf &
                                 "    myLabel.ForeColor = colorDlg.Color" & vbCrLf &
                                 "End If"
        ' extra controls: label, color button, font button
        Dim extra As Action(Of Panel) = Sub(parent)
                                            Dim extraArea As Panel = Nothing
                                            If parent.Controls.Count > 0 Then extraArea = TryCast(parent.Controls(0), Panel)
                                            If extraArea Is Nothing Then extraArea = parent

                                            Dim flow As New FlowLayoutPanel() With {.FlowDirection = FlowDirection.TopDown, .Dock = DockStyle.Top, .AutoSize = True, .Padding = New Padding(6)}
                                            extraArea.Controls.Add(flow)

                                            Dim demoLabel As New Label() With {.Text = "Sample Text", .AutoSize = True, .Font = New Font("Segoe UI", 12.0F), .ForeColor = Theme_Text}
                                            flow.Controls.Add(demoLabel)

                                            Dim btnPanel As New FlowLayoutPanel() With {.FlowDirection = FlowDirection.LeftToRight, .AutoSize = True}
                                            Dim btnColor As New Button() With {.Text = "Choose Color", .AutoSize = True, .FlatStyle = FlatStyle.Flat, .BackColor = Theme_Primary, .ForeColor = Theme_Text}
                                            btnColor.FlatAppearance.BorderSize = 0
                                            Dim btnFont As New Button() With {.Text = "Choose Font", .AutoSize = True, .FlatStyle = FlatStyle.Flat, .BackColor = Theme_Primary, .ForeColor = Theme_Text}
                                            btnFont.FlatAppearance.BorderSize = 0
                                            btnPanel.Controls.AddRange(New Control() {btnColor, btnFont})
                                            flow.Controls.Add(btnPanel)

                                            Dim colorDlg As New ColorDialog()
                                            AddHandler btnColor.Click, Sub(s, e)
                                                                           If colorDlg.ShowDialog() = DialogResult.OK Then
                                                                               demoLabel.ForeColor = colorDlg.Color
                                                                           End If
                                                                       End Sub
                                            Dim fontDlg As New FontDialog()
                                            AddHandler btnFont.Click, Sub(s, e)
                                                                          If fontDlg.ShowDialog() = DialogResult.OK Then
                                                                              demoLabel.Font = fontDlg.Font
                                                                          End If
                                                                      End Sub
                                        End Sub
        Dim runner As Action(Of Control) = Sub(output)
                                               If TypeOf output Is RichTextBox Then
                                                   DirectCast(output, RichTextBox).AppendText("Use the Choose Color / Choose Font buttons on the right to change the sample label." & vbCrLf)
                                               End If
                                           End Sub
        pnlContent.Controls.Add(CreateLessonPanel("Working with Controls and Properties", explanation, codeText, runner, "RichTextBox", extra))
    End Sub

