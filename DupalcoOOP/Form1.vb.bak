    ' ----- Animation Level 1: Cannibals and Missionaries -----
    Private Sub ShowAnimation_Level1()
        pnlContent.Controls.Clear()

        ' Create container (themed)
        animPanel = New Panel() With {
            .Dock = DockStyle.Fill,
            .BackColor = Theme_Background,
            .AutoScroll = True,
            .Padding = New Padding(12)
        }
        ' Top controls container
        Dim topPanel As New Panel() With {.Dock = DockStyle.Top, .Height = 48, .BackColor = Color.Transparent}
        animPanel.Controls.Add(topPanel)
        Dim lblMoves As New Label() With {.Name = "lblMoves", .Text = "Moves: 0", .Location = New Point(8, 14), .AutoSize = True, .ForeColor = Theme_Text, .Font = New Font("Segoe UI", 10.0F, FontStyle.Bold)}
        topPanel.Controls.Add(lblMoves)
        Dim btnGo As New Button() With {.Text = "Go", .Location = New Point(120, 8), .Size = New Size(96, 32), .FlatStyle = FlatStyle.Flat, .BackColor = Theme_Accent, .ForeColor = Color.Black}
        btnGo.FlatAppearance.BorderSize = 0
        Dim btnReset As New Button() With {.Text = "Reset", .Location = New Point(228, 8), .Size = New Size(96, 32), .FlatStyle = FlatStyle.Flat, .BackColor = Theme_Primary, .ForeColor = Theme_Text}
        btnReset.FlatAppearance.BorderSize = 0
        topPanel.Controls.AddRange(New Control() {btnGo, btnReset})

        ' Make a drawing area
        Dim drawArea As New Panel() With {
            .Location = New Point(8, 64),
            .Size = New Size(760, 560),
            .BorderStyle = BorderStyle.FixedSingle,
            .BackColor = Color.FromArgb(6, 10, 20)
        }
        ' Enable double buffering
        SetDoubleBuffered(drawArea, True)
        animPanel.Controls.Add(drawArea)

        ' State initialization
        animState = New CannibalsState()
        animState.Reset()

        ' Timer for animation
        animTimer = New Timer() With {.Interval = 20}
        AddHandler animTimer.Tick, Sub(s, e)
                                       If animBoatMoving Then
                                           ' Simple linear interpolation towards target
                                           If animBoatX < animBoatTargetX Then
                                               animBoatX += 8
                                               If animBoatX >= animBoatTargetX Then
                                                   animBoatX = animBoatTargetX
                                                   animBoatMoving = False
                                                   animTimer.Stop()
                                                   ' finalize move
                                                   animState.CompleteBoatCrossing()
                                                   animMoveCounter += 1
                                                   Dim _lbl = TryCast(animPanel.Controls.Find("lblMoves", True).FirstOrDefault(), Label)
                                                   If _lbl IsNot Nothing Then _lbl.Text = $"Moves: {animMoveCounter}"
                                                   CheckWinLose(animPanel)
                                               End If
                                           ElseIf animBoatX > animBoatTargetX Then
                                               animBoatX -= 8
                                               If animBoatX <= animBoatTargetX Then
                                                   animBoatX = animBoatTargetX
                                                   animBoatMoving = False
                                                   animTimer.Stop()
                                                   animState.CompleteBoatCrossing()
                                                   animMoveCounter += 1
                                                   Dim _lbl2 = TryCast(animPanel.Controls.Find("lblMoves", True).FirstOrDefault(), Label)
                                                   If _lbl2 IsNot Nothing Then _lbl2.Text = $"Moves: {animMoveCounter}"
                                                   CheckWinLose(animPanel)
                                               End If
                                           End If
                                           drawArea.Invalidate()
                                       End If
                                   End Sub

        ' Clickable shapes: selector buttons for each character (placed to the right)
        Dim charPanel As New FlowLayoutPanel() With {.Location = New Point(780, 64), .Size = New Size(200, 560), .AutoScroll = True, .FlowDirection = FlowDirection.TopDown}
        charPanel.BackColor = Color.Transparent
        animPanel.Controls.Add(charPanel)

        For i As Integer = 0 To 5
            Dim btn As New CheckBox() With {
                .Appearance = Appearance.Button,
                .AutoSize = False,
                .Size = New Size(180, 42),
                .Tag = i,
                .Text = animState.PersonName(i),
                .FlatStyle = FlatStyle.Flat,
                .BackColor = Color.Transparent,
                .ForeColor = Theme_Text,
                .TextAlign = ContentAlignment.MiddleCenter
            }
            btn.FlatAppearance.BorderSize = 1
            btn.FlatAppearance.BorderColor = Theme_Border
            AddHandler btn.CheckedChanged, Sub(s, e)
                                               Dim cbx = DirectCast(s, CheckBox)
                                               If cbx.Checked Then
                                                   cbx.BackColor = Theme_Primary
                                                   cbx.ForeColor = Theme_Text
                                               Else
                                                   cbx.BackColor = Color.Transparent
                                                   cbx.ForeColor = Theme_Text
                                               End If
                                               ' limit maximum selected to 2
                                               Dim selectedCount = 0
                                               For Each ctrl As Control In charPanel.Controls
                                                   Dim ck = TryCast(ctrl, CheckBox)
                                                   If ck IsNot Nothing AndAlso ck.Checked Then selectedCount += 1
                                               Next
                                               If selectedCount > 2 Then
                                                   cbx.Checked = False
                                               End If
                                           End Sub
            charPanel.Controls.Add(btn)
        Next

        ' Go button behavior: place selected people on boat, animate across
        AddHandler btnGo.Click, Sub(s, e)
                                    If animBoatMoving Then Return
                                    ' determine selected people indices
                                    Dim selected As New List(Of Integer)
                                    For Each ctrl As Control In charPanel.Controls
                                        Dim cb = TryCast(ctrl, CheckBox)
                                        If cb IsNot Nothing AndAlso cb.Checked Then
                                            selected.Add(CInt(cb.Tag))
                                        End If
                                    Next
                                    If selected.Count < 1 OrElse selected.Count > 2 Then
                                        MessageBox.Show("Select 1 or 2 people to move.", "Invalid move", MessageBoxButtons.OK, MessageBoxIcon.Information)
                                        Return
                                    End If
                                    ' Ensure selected are on same bank as boat
                                    If Not animState.CanBoard(selected) Then
                                        MessageBox.Show("Selected person(s) must be on the same bank as the boat.", "Invalid move", MessageBoxButtons.OK, MessageBoxIcon.Information)
                                        Return
                                    End If
                                    ' Put selected on boat
                                    animState.Board(selected)
                                    ' Set animation targets
                                    animBoatMoving = True
                                    If animState.BoatOnLeft Then
                                        animBoatTargetX = drawArea.Width - 220
                                    Else
                                        animBoatTargetX = 20
                                    End If
                                    animTimer.Start()
                                End Sub

        ' Reset button
        AddHandler btnReset.Click, Sub(s, e)
                                       animTimer.Stop()
                                       animBoatMoving = False
                                       animMoveCounter = 0
                                       Dim _lblReset = TryCast(animPanel.Controls.Find("lblMoves", True).FirstOrDefault(), Label)
                                       If _lblReset IsNot Nothing Then _lblReset.Text = "Moves: 0"
                                       animState.Reset()
                                       animBoatX = 20
                                       drawArea.Invalidate()
                                       ' uncheck selectors
                                       For Each ctrl As Control In charPanel.Controls
                                           Dim cb = TryCast(ctrl, CheckBox)
                                           If cb IsNot Nothing Then cb.Checked = False
                                       Next
                                   End Sub

        ' initial boat position
        animBoatX = 20
        animBoatTargetX = 20
        animBoatMoving = False

        ' Drawing handler
        AddHandler drawArea.Paint, Sub(s, e)
                                       DrawCannibalsScene(e.Graphics, drawArea.ClientSize)
                                   End Sub

        pnlContent.Controls.Add(animPanel)
    End Sub

    Private Sub CheckWinLose(container As Control)
        Dim lbl = TryCast(container.Controls("lblMoves"), Label)
        ' Check if game over or win
        If animState.CheckLose() Then
            MessageBox.Show("Cannibals have outnumbered missionaries — you lose.", "Game Over", MessageBoxButtons.OK, MessageBoxIcon.Warning)
        ElseIf animState.CheckWin() Then
            MessageBox.Show($"You win! Moves: {animMoveCounter}", "Victory", MessageBoxButtons.OK, MessageBoxIcon.Information)
        End If
    End Sub

    ' Drawing the game scene
    Private Sub DrawCannibalsScene(g As Graphics, size As Size)
        g.SmoothingMode = Drawing2D.SmoothingMode.AntiAlias
        ' Banks
        Dim leftBankRect As New Rectangle(0, 0, size.Width \ 2 - 80, size.Height)
        Dim rightBankRect As New Rectangle(size.Width \ 2 + 80, 0, size.Width \ 2 - 80, size.Height)
        g.FillRectangle(Brushes.PaleGreen, leftBankRect)
        g.FillRectangle(Brushes.LightSalmon, rightBankRect)

        ' River center area
        Dim riverRect As New Rectangle(size.Width \ 2 - 80, 0, 160, size.Height)
        g.FillRectangle(Brushes.LightSkyBlue, riverRect)

        ' Draw boat
        Dim boatY = size.Height - 140
        Dim boatW = 180
        Dim boatH = 60
        Dim boatX = animBoatX
        g.FillRectangle(Brushes.SaddleBrown, boatX, boatY, boatW, boatH)
        g.DrawRectangle(Pens.Black, boatX, boatY, boatW, boatH)

        ' Draw people: positions left and right banks and on boat
        Dim leftPositions As New List(Of Point)
        For i As Integer = 0 To 2
            leftPositions.Add(New Point(40, 60 + i * 120))
        Next
        Dim rightPositions As New List(Of Point)
        For i As Integer = 0 To 2
            rightPositions.Add(New Point(size.Width - 40, 60 + i * 120))
        Next

        For i As Integer = 0 To 5
            Dim pos As Point
            Dim name = animState.PersonName(i)
            Dim clr As Color = If(animState.IsCannibal(i), Color.DarkRed, Color.DarkBlue)
            If animState.IsOnBoat(i) Then
                ' compute relative boat slot
                Dim slotIndex = animState.BoatSlotIndex(i)
                pos = New Point(boatX + 20 + slotIndex * 70, boatY - 40)
            ElseIf animState.IsOnLeft(i) Then
                pos = leftPositions(animState.LeftIndex(i))
            Else
                pos = rightPositions(animState.RightIndex(i))
            End If
            ' Draw circle and text
            Dim circleRect As New Rectangle(pos.X - 20, pos.Y - 20, 40, 40)
            Using br As New SolidBrush(clr)
                g.FillEllipse(br, circleRect)
            End Using
            g.DrawEllipse(Pens.Black, circleRect)
            ' label initial: M1..M3, C1..C3
            Dim sf As New StringFormat() With {.Alignment = StringAlignment.Center}
            g.DrawString(name, New Font("Segoe UI", 8.0F), Brushes.Black, pos.X, pos.Y + 24, sf)
        Next
    End Sub

