    ' Utility: enable double buffering on a control
    Private Shared Sub SetDoubleBuffered(c As Control, value As Boolean)
        Dim prop = GetType(Control).GetProperty("DoubleBuffered", System.Reflection.BindingFlags.Instance Or System.Reflection.BindingFlags.NonPublic)
        prop.SetValue(c, value, Nothing)
    End Sub

    ' ----- Helper classes for the lessons -----
    ' Person sample
    Public Class Person
        Public Property Name As String
        Public Property Age As Integer
        Public Sub New()
            Name = String.Empty
            Age = 0
        End Sub
    End Class

    ' BankAccount for Encapsulation demo
    Public Class BankAccount
        Private balance As Decimal = 0D

        Public Sub Deposit(amount As Decimal)
            If amount <= 0D Then
                Throw New ArgumentException("Deposit amount must be positive.")
            End If
            balance += amount
        End Sub

        ' Returns True on success, False on failure (insufficient funds or invalid)
        Public Function Withdraw(amount As Decimal) As Boolean
            If amount <= 0D Then
                Return False
            End If
            If amount > balance Then
                Return False
            End If
            balance -= amount
            Return True
        End Function

        Public Function GetBalance() As Decimal
            Return balance
        End Function
    End Class

    ' Animal / Dog for inheritance demo
    Public Class Animal
        Public Overridable Function Speak() As String
            Return "(animal sound)"
        End Function
    End Class

    Public Class Dog
        Inherits Animal
        Public Overrides Function Speak() As String
            Return "Dog barks"
        End Function
    End Class

    ' ----- Simple game state for Cannibals & Missionaries -----
    Private Class CannibalsState
        ' Indexing: 0..2 = Missionaries (M1,M2,M3), 3..5 = Cannibals (C1,C2,C3)
        ' For each person: -1 means on right bank index, else left bank index position
        Private leftPositions(5) As Integer
        Private rightPositions(5) As Integer
        Private onBoat(5) As Boolean
        Private boatSlots(2) As Integer ' which person index in each slot or -1
        Public BoatOnLeft As Boolean = True

        Public Sub New()
            Reset()
        End Sub

        Public Sub Reset()
            ' Place all on left bank with left indices 0..2 for missionaries and 0..2 for cannibals
            For i As Integer = 0 To 2
                leftPositions(i) = i ' M1..M3 left
            Next
            For i As Integer = 3 To 5
                leftPositions(i) = i - 3 ' C1..C3 left
            Next
            For i As Integer = 0 To 5
                onBoat(i) = False
            Next
            For s As Integer = 0 To 1
                boatSlots(s) = -1
            Next
            BoatOnLeft = True
        End Sub

        Public Function PersonName(index As Integer) As String
            If index < 3 Then
                Return "M" & (index + 1).ToString()
            Else
                Return "C" & (index - 2).ToString()
            End If
        End Function

        Public Function IsCannibal(index As Integer) As Boolean
            Return index >= 3
        End Function

        Public Function IsOnBoat(index As Integer) As Boolean
            Return onBoat(index)
        End Function

        Public Function IsOnLeft(index As Integer) As Boolean
            Return Not onBoat(index) AndAlso leftPositions(index) >= 0
        End Function

        Public Function LeftIndex(index As Integer) As Integer
            Return leftPositions(index)
        End Function

        Public Function RightIndex(index As Integer) As Integer
            Return If(leftPositions(index) = -1, index Mod 3, 0)
        End Function

        Public Function BoatSlotIndex(index As Integer) As Integer
            For s As Integer = 0 To 1
                If boatSlots(s) = index Then Return s
            Next
            Return 0
        End Function

        ' Check if selected people are on same bank as boat
        Public Function CanBoard(selected As List(Of Integer)) As Boolean
            For Each idx In selected
                If onBoat(idx) Then Return False
                If BoatOnLeft Then
                    ' must be on left
                    If leftPositions(idx) < 0 Then Return False
                Else
                    If leftPositions(idx) >= 0 Then Return False
                End If
            Next
            Return True
        End Function

        ' Put people on boat (assumes valid)
        Public Sub Board(selected As List(Of Integer))
            ' place in first available boatSlots
            For Each idx In selected
                Dim placed As Boolean = False
                For s As Integer = 0 To 1
                    If boatSlots(s) = -1 Then
                        boatSlots(s) = idx
                        onBoat(idx) = True
                        ' mark leftPositions to -1 if they leave left bank, or -2 to indicate right bank removal later
                        If BoatOnLeft Then
                            leftPositions(idx) = -1
                        Else
                            leftPositions(idx) = -2
                        End If
                        placed = True
                        Exit For
                    End If
                Next
                If Not placed Then
                    ' should not happen
                End If
            Next
            ' start crossing (actual crossing completion handled by outer logic)
            BoatOnLeft = Not BoatOnLeft ' boat moves immediately (visual handled externally)
        End Sub

        ' Complete crossing: offload boat occupants to the other bank
        Public Sub CompleteBoatCrossing()
            ' boat has moved to BoatOnLeft state (already toggled in Board); we need to place boatSlots occupants on current bank
            For s As Integer = 0 To 1
                Dim idx = boatSlots(s)
                If idx <> -1 Then
                    onBoat(idx) = False
                    ' place on left or right depending on BoatOnLeft
                    If BoatOnLeft Then
                        leftPositions(idx) = idx Mod 3 ' place on left bank index (simple)
                    Else
                        leftPositions(idx) = -1 ' mark as right side (not on left)
                    End If
                    boatSlots(s) = -1
                End If
            Next
        End Sub

        ' Check lose condition: on either bank, cannibals > missionaries while missionaries > 0
        Public Function CheckLose() As Boolean
            ' Count on left
            Dim mLeft As Integer = 0, cLeft As Integer = 0
            For i As Integer = 0 To 5
                If Not onBoat(i) Then
                    If leftPositions(i) >= 0 Then
                        If IsCannibal(i) Then cLeft += 1 Else mLeft += 1
                    End If
                End If
            Next
            ' Count on right
            Dim mRight As Integer = 0, cRight As Integer = 0
            For i As Integer = 0 To 5
                If Not onBoat(i) Then
                    If leftPositions(i) = -1 Then
                        If IsCannibal(i) Then cRight += 1 Else mRight += 1
                    End If
                End If
            Next
            If mLeft > 0 AndAlso cLeft > mLeft Then Return True
            If mRight > 0 AndAlso cRight > mRight Then Return True
            Return False
        End Function

        Public Function CheckWin() As Boolean
            ' Win when all on right (leftPositions == -1)
            For i As Integer = 0 To 5
                If leftPositions(i) <> -1 Then Return False
            Next
            Return True
        End Function

        ' Helpers for UI placement (no duplicate LeftIndex — use LeftIndex(index) defined above)
    End Class

End Class
