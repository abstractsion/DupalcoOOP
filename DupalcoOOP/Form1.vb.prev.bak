        sections.Add(Tuple.Create("Methods & Events", "Example: MessageBox.Show. Events like Form1_Load (Handles MyBase.Load)."))
        sections.Add(Tuple.Create("Common controls", "Form, TextBox, Label, Button, ListBox, ComboBox, RadioButton, CheckBox, PictureBox, ProgressBar, ScrollBar, DateTimePicker."))
        sections.Add(Tuple.Create("Layout & Navigation", "Anchor vs Dock. TabIndex and TabStop for keyboard navigation."))
        Dim code = "' Example Form Load handler" & vbCrLf &
                   "Private Sub Form1_Load(sender As Object, e As EventArgs) Handles MyBase.Load" & vbCrLf &
                   "    MessageBox.Show(""Form loaded"")" & vbCrLf &
                   "End Sub"
        Dim runner As Action(Of RichTextBox) = Sub(rtb)
                                                   rtb.Clear()
                                                   rtb.AppendText("MessageBox.Show sample not run here. See Form Load events." & vbCrLf)
                                               End Sub
        pnlContent.Controls.Add(BuildLessonPage("Planning Applications and Designing Interfaces", "Design & Controls", sections, code, runner))
    End Sub

    Private Sub ShowDataHandling()
        pnlContent.Controls.Clear()
        lblContext.Text = "Lessons / Data Handling"
        Dim sections As New List(Of Tuple(Of String, String))
        sections.Add(Tuple.Create("Variables", "Variables and memory; naming rules; Dim declarations."))
        sections.Add(Tuple.Create("Types & Constants", "Data types; Const and named constants; type-declaration characters (D, R, I, L, S, F)."))
        sections.Add(Tuple.Create("Conversions", "Implicit vs explicit conversion; Convert and Parse; ToString formats."))
        sections.Add(Tuple.Create("Operators & Precedence", "Arithmetic operators (+ - * / ^ \ Mod); order of precedence; assignment operators (+=, -=)."))
        Dim code = "' Exponent example" & vbCrLf &
                   "Dim baseValue As Double = 2.0" & vbCrLf &
                   "Dim power As Double = 3.0" & vbCrLf &
                   "Console.WriteLine(Math.Pow(baseValue, power))"
        Dim runner As Action(Of RichTextBox) = Sub(rtb)
                                                   Dim baseValue As Double = 2.0
                                                   Dim power As Double = 3.0
                                                   rtb.Clear()
                                                   rtb.AppendText($"{baseValue}^{power} = {Math.Pow(baseValue, power):N0}" & vbCrLf)
                                               End Sub
        pnlContent.Controls.Add(BuildLessonPage("Data Handling", "Variables & Types", sections, code, runner))
    End Sub

    Private Sub ShowCodingSelectionRepetition()
        pnlContent.Controls.Clear()
        lblContext.Text = "Lessons / Selection and Repetition"
        Dim sections As New List(Of Tuple(Of String, String))
        sections.Add(Tuple.Create("Selection", "If / ElseIf / Else; relational operators; Boolean flags; nested If; Select Case."))
        sections.Add(Tuple.Create("Logical Operators", "And, Or, Xor, Not, AndAlso, OrElse (with truth tables)."))
        sections.Add(Tuple.Create("String handling", "Comparison, String.Empty, ToUpper, ToLower, IsNumeric, Length, Trim."))
        sections.Add(Tuple.Create("Loops", "Do While; For...Next; nested loops."))
        Dim code = "' If example" & vbCrLf &
                   "Dim score As Integer = 75" & vbCrLf &
                   "If score >= 90 Then" & vbCrLf &
                   "    Console.WriteLine(""A"")" & vbCrLf &
                   "ElseIf score >= 80 Then" & vbCrLf &
                   "    Console.WriteLine(""B"")" & vbCrLf &
                   "ElseIf score >= 70 Then" & vbCrLf &
                   "    Console.WriteLine(""C"")" & vbCrLf &
                   "Else" & vbCrLf &
                   "    Console.WriteLine(""Fail"")" & vbCrLf &
                   "End If"
        Dim runner As Action(Of RichTextBox) = Sub(rtb)
                                                   Dim score As Integer = 75
                                                   Dim grade As String
                                                   If score >= 90 Then
                                                       grade = "A"
                                                   ElseIf score >= 80 Then
                                                       grade = "B"
                                                   ElseIf score >= 70 Then
                                                       grade = "C"
                                                   Else
                                                       grade = "Fail"
                                                   End If
                                                   rtb.Clear()
                                                   rtb.AppendText($"Score {score} ? Grade {grade}" & vbCrLf)
                                               End Sub
        pnlContent.Controls.Add(BuildLessonPage("Coding with Variable Names, Constants and Calculations", "Selection & Repetition", sections, code, runner))
    End Sub

    Private Sub ShowArrays()
        pnlContent.Controls.Clear()
        lblContext.Text = "Lessons / Arrays"
        Dim sections As New List(Of Tuple(Of String, String))
        sections.Add(Tuple.Create("Characteristics", "Array characteristics; Dim name(upper) As Type; default initialization; implicit sizing with { }."))
        sections.Add(Tuple.Create("Usage", "Named-constant subscripts; one-dimensional and two-dimensional arrays; multi-dimensional arrays."))
        sections.Add(Tuple.Create("Functions & Arrays", "Functions (including Return); passing arrays to procedures; returning an array from a function."))
        Dim code = "' Months array example" & vbCrLf &
                   "Dim months() As String = {""January"", ""February"", ""March"", ""April"", ""May"", ""June"", ""July"", ""August"", ""September"", ""October"", ""November"", ""December""}" & vbCrLf &
                   "For i As Integer = 0 To months.Length - 1" & vbCrLf &
                   "    Console.WriteLine(months(i))" & vbCrLf &
                   "Next"
        Dim runner As Action(Of RichTextBox) = Sub(rtb)
                                                   rtb.Clear()
                                                   Dim months() As String = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
                                                   For i As Integer = 0 To months.Length - 1
                                                       rtb.AppendText(months(i) & vbCrLf)
                                                   Next
                                               End Sub
        pnlContent.Controls.Add(BuildLessonPage("Arrays", "Collections of values", sections, code, runner))
    End Sub

    Private Sub ShowControlsProperties()
        pnlContent.Controls.Clear()
        lblContext.Text = "Lessons / Working with Controls and Properties"
        Dim sections As New List(Of Tuple(Of String, String))
        sections.Add(Tuple.Create("Dialogs", "Dialog boxes: CommonDialog, ShowDialog, DialogResult values."))
        sections.Add(Tuple.Create("Common dialogs", "ColorDialog, FontDialog, OpenFileDialog, SaveFileDialog, PrintDialog."))
        sections.Add(Tuple.Create("TreeView/ListView", "[TREEVIEW / LISTVIEW CONTENT - NOT IN SLIDES]"))
        Dim code = "' Example: ColorDialog usage" & vbCrLf &
                   "If colorDlg.ShowDialog() = DialogResult.OK Then" & vbCrLf &
                   "    myLabel.ForeColor = colorDlg.Color" & vbCrLf &
                   "End If"
        Dim runner As Action(Of RichTextBox) = Sub(rtb)
                                                   rtb.Clear()
                                                   rtb.AppendText("Use the Choose Color / Choose Font buttons on the right to change the sample label." & vbCrLf)
                                               End Sub
        ' Extra interactive area: color/font demos
        Dim extra As Action(Of Panel) = Sub(parent)
                                            parent.Controls.Clear()
                                            Dim flow As New FlowLayoutPanel() With {.Dock = DockStyle.Top, .AutoSize = True, .Padding = New Padding(6)}
                                            parent.Controls.Add(flow)
                                            Dim demoLabel As New Label() With {.Text = "Sample Text", .AutoSize = True, .Font = New Font("Segoe UI", 12.0F), .ForeColor = Theme_Text}
                                            flow.Controls.Add(demoLabel)
                                            Dim btnPanel As New FlowLayoutPanel() With {.FlowDirection = FlowDirection.LeftToRight, .AutoSize = True}
                                            Dim btnColor = CreatePrimaryButton("Choose Color", Sub()
                                                                                                   Dim cd As New ColorDialog()
                                                                                                   If cd.ShowDialog() = DialogResult.OK Then demoLabel.ForeColor = cd.Color
                                                                                               End Sub)
                                            Dim btnFont = CreatePrimaryButton("Choose Font", Sub()
                                                                                                 Dim fd As New FontDialog()
                                                                                                 If fd.ShowDialog() = DialogResult.OK Then demoLabel.Font = fd.Font
                                                                                             End Sub)
                                            btnPanel.Controls.AddRange(New Control() {btnColor, btnFont})
                                            flow.Controls.Add(btnPanel)
                                        End Sub
        pnlContent.Controls.Add(BuildLessonPage("Working with Controls and Properties", "Dialogs & Controls", sections, code, runner, extra))
    End Sub

