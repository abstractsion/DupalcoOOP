\pard\li360\sb60\sa140\f1\fs22\cf5 {\cf5 Evaluating}{\cf5  }{\cf5 the}{\cf5  }{\cf5 logical}{\cf5  }{\cf5 operators}{\cf5  }{\cf5 leaves}\line {\cf2 False}\par
\pard\tx360\li360\fi-360\sa80\f0\fs26\cf1 \u8226?\tab Parentheses make order of operations clear\par
\pard\li360\sb60\sa140\f1\fs22\cf5 {\cf2 If}{\cf5  }{\cf5 (}{\cf5 x}{\cf5  }{\cf5 >}{\cf5  }{\cf5 (}{\cf5 a}{\cf5  }{\cf5 *}{\cf5  }{\cf6 10}{\cf5 )}{\cf5 )}{\cf5  }{\cf2 And}{\cf5  }{\cf5 (}{\cf5 y}{\cf5  }{\cf5 <}{\cf5  }{\cf5 (}{\cf5 b}{\cf5  }{\cf5 +}{\cf5  }{\cf6 20}{\cf5 )}{\cf5 )}\par
