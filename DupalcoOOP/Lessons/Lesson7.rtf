\pard\li360\sb60\sa140\f1\fs22\cf5 {\cf2 Decimal}{\cf5  }{\cf5 elements}{\cf5  }{\cf5 are}{\cf5  }{\cf5 initialized}{\cf5  }{\cf2 to}{\cf5  }{\cf5 zero}{\cf5  }{\cf5 (}{\cf6 0.0}{\cf5 )}\par
